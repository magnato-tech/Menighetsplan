# Utvikling: mock som standard. Sett true for å teste Google Sheets på localhost.
# Produksjonsbuild ignorerer denne og bruker alltid Sheets.
VITE_USE_REMOTE_DATA=false

# Google Apps Script Web App (slutter på /exec)
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbznLoq62orP53izSEA0wnA7VdQHiNWpP3upTo2nd1owcL3LDZp13gK8LxrAdsjxWwt7vw/exec"

# Google Identity (Web client ID). Påkrevd for «Logg inn med Google» på startsiden.
# Opprett OAuth-klient i Google Cloud, type Web, med JavaScript-opprinnelse for appen.
VITE_GOOGLE_CLIENT_ID=""

# Samme verdi må også ligge i Apps Script: Prosjektinnstillinger → Script properties
# nøkkel GOOGLE_CLIENT_ID (brukes til å verifisere Google-token på serveren).

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
