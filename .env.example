# Utvikling: mock som standard. Sett true for å teste Supabase på localhost.
# Produksjonsbuild ignorerer denne og bruker alltid /api/db.
VITE_USE_REMOTE_DATA=false

# Google Apps Script Web App (slutter på /exec) — backup, import, første overføring
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbznLoq62orP53izSEA0wnA7VdQHiNWpP3upTo2nd1owcL3LDZp13gK8LxrAdsjxWwt7vw/exec"

# Supabase (ikke VITE_ — bare server / Vite-plugin /api/db)
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# MIGRATE_FROM_SHEETS=true

# Google Identity (Web client ID). Påkrevd for «Logg inn med Google» på startsiden.
VITE_GOOGLE_CLIENT_ID=""

# Samme verdi på serveren som GOOGLE_CLIENT_ID (Vercel / .env.local) for å verifisere Google-token.

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
